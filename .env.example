# MotherDuck PostgreSQL compatibility endpoint.
MOTHERDUCK_POSTGRES_HOST=
MOTHERDUCK_POSTGRES_URL=
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=inventory_cbt

# WMS credentials. Keep these server-side only.
WMS_ACCESS_TOKEN=
WMS_DEVICE=desktop-admin
WMS_DEVICE_ID=

# Superset session. Store either the raw value or `session=<value>`.
SUPERSET_BASE_URL=https://dash.astronauts.id
SUPERSET_SESSION_COOKIE=

# Shared only by cron-job.org and the server-side endpoint.
SYNC_SECRET=
