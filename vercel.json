{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/putaway",
      "destination": "/preview/putaway-superset-ledger.html?live=1",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/putaway",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/occupancy",
      "destination": "/preview/occupancy-dashboard-preview.html"
    }
  ],
  "functions": {
    "api/sync-soh.js": {
      "maxDuration": 300
    },
    "api/rack-status.js": {
      "maxDuration": 60
    },
    "api/occupancy-dashboard.js": {
      "maxDuration": 60
    },
    "api/planogram-detail.js": {
      "maxDuration": 60
    },
    "api/sync-putaway.js": {
      "maxDuration": 300
    }
  }
}
